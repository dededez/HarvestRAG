# Copy to .env.v2 for docker compose --env-file .env.v2 -f compose.v2.yaml ...
# Percent-encode special characters if using a password inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
V2_API_KEY=replace-with-a-random-api-key
V2_EMBEDDING_MODEL=BAAI/bge-m3
V2_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
V2_RERANKER_ENABLED=true
V2_BROWSER_ENABLED=true
V2_NEAR_DUPLICATE_ENABLED=false
# Set the provider key matching config/agents.json when using LLM extraction/answers.
DEEPSEEK_API_KEY=
# For native Python (export these variables in your shell or put in existing .env):
# V2_DATABASE_URL=postgresql://scraper:password@127.0.0.1:5432/scraper
# V2_MILVUS_URI=http://127.0.0.1:19530
# V2_ARTIFACT_DIR=D:/scraper-data/artifacts
